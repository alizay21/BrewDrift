# Brewdrift App Environment Variables
# Copy this to .env and fill in your values

# Backend API base URL
# Use 10.0.2.2 for Android emulator connecting to localhost
API_BASE_URL=http://192.168.18.227:8000

# Google Maps Android API Key (for flutter app)
GOOGLE_MAPS_ANDROID_API_KEY=YOUR_GOOGLE_MAPS_ANDROID_API_KEY_HERE

# Google Places API Key (for backend only - never put in Flutter app)
# This is only used by the backend/app/.env file
